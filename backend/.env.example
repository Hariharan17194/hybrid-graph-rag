# Copy this file to .env and fill in what you need.
# Defaults below run fully locally with Ollama + sentence-transformers --
# no API keys required to get started.

# --- LLM provider: ollama | openai | anthropic ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embedding provider: local | openai ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Guardrails ---
MAX_QUESTION_CHARS=2000
BLOCK_SUSPECTED_INJECTION=true

# --- LLM call timeout (seconds) ---
LLM_TIMEOUT_SECONDS=60
